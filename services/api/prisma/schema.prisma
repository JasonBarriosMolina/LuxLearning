generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Course {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  description        String
  imageUrl           String?
  isActive           Boolean           @default(false)
  isPilot            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  tags               String[]          @default([])
  closeDate          DateTime?
  startDate          DateTime?
  createdByName      String?
  evaluatorName      String?
  evaluatorId        String?
  isArchived         Boolean           @default(false)
  isDraft            Boolean           @default(false)
  academicPeriod     String?
  calendarExceptions Json?
  cardBorderColor    String?
  cardColor          String?
  cardLabels         String[]          @default([])
  classDays          String[]          @default([])
  classSchedule      String?
  courseType         String?
  evaluationConfig   Json?
  modality           String?
  planDocumentS3Key  String?
  planLanguage       String?           @default("ES")
  totalWeeks         Int?
  pilotoAutomatico   Boolean           @default(false)
  isAutoevaluated    Boolean           @default(false)
  planSyllabusInput  String?
  planWeeklyPlan     Json?
  sessions           CourseSession[]
  evaluationEvents   EvaluationEvent[]
  modules            Module[]
}

model CourseSession {
  id          String   @id @default(cuid())
  courseId    String
  sessionDate DateTime
  weekIndex   Int?
  order       Int
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model AcademicPeriod {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EvaluationEvent {
  id               String    @id @default(cuid())
  courseId         String
  type             String
  name             String
  dueDate          DateTime?
  weight           Float
  instructions     String?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  moduleId         String?
  vapiObjectives   String?
  vapiPrompt       String?
  targetStudentIds String[]  @default([])
  isArchived       Boolean   @default(false)
  isDraft          Boolean   @default(false)
  lessonScript     String?
  lessonVideoUrl   String?
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
}

model Module {
  id           String     @id @default(cuid())
  courseId     String
  order        Int
  title        String
  description  String
  duration     String
  passingScore Int
  lessons      Lesson[]
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@unique([courseId, order])
}

model Lesson {
  id           String   @id @default(cuid())
  moduleId     String
  order        Int
  title        String
  duration     String
  youtubeId    String   @default("")
  imageUrl     String?
  points       String[]
  tip          String
  content      String?
  type         String   @default("video")
  audioUrl     String?
  prevSnapshot String?
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
}

model Question {
  id           String   @id @default(cuid())
  moduleId     String
  order        Int
  text         String
  options      String[]
  correctIndex Int
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
}

model StudentGroup {
  id                   String                  @id @default(cuid())
  name                 String
  description          String?
  createdAt            DateTime                @default(now())
  color                String                  @default("#17527E")
  createdByEvaluatorId String?
  evaluators           StudentGroupEvaluator[]
  members              StudentGroupMember[]
}

model StudentGroupMember {
  groupId           String
  userId            String
  addedAt           DateTime     @default(now())
  enrolledCourseIds String[]     @default([])
  group             StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model StudentGroupEvaluator {
  groupId     String
  evaluatorId String
  assignedAt  DateTime     @default(now())
  group       StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, evaluatorId])
}
