generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Course {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  description        String
  imageUrl           String?
  isActive           Boolean           @default(false)
  isPilot            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  tags               String[]          @default([])
  closeDate          DateTime?
  startDate          DateTime?
  createdByName      String?
  evaluatorName      String?
  evaluatorId        String?
  isArchived         Boolean           @default(false)
  isDraft            Boolean           @default(false)
  academicPeriod     String?
  calendarExceptions Json?
  cardBorderColor    String?
  cardColor          String?
  cardLabels         String[]          @default([])
  classDays          String[]          @default([])
  classSchedule      String?
  courseType         String?
  evaluationConfig   Json?
  modality           String?
  planDocumentS3Key  String?
  planLanguage       String?           @default("ES")
  totalWeeks         Int?
  pilotoAutomatico   Boolean           @default(false)
  isAutoevaluated    Boolean           @default(false)
  // Lux Planner weekly-pacing toggle (Trello DmPpbrff, 2026-09-01 01:48 — Mack):
  // "free flow" (default, off) unlocks module N as soon as module N-1's reflection
  // is approved, regardless of date. "strict" (on) additionally requires the
  // course's calendar week N to have arrived — anchored to startDate, module order
  // = week number (Jason, 2026-09-01: same startDate for every student, not
  // per-enrollment). See isModuleUnlocked in shared/db-progress.ts.
  weeklyPacingEnabled Boolean          @default(false)
  planSyllabusInput  String?
  planWeeklyPlan     Json?
  // Trello DmPpbrff, 2026-09-05 (Mack): "Editar con Lux Planner" reopened a course with
  // the "Módulos — Quiz, Reflexión y Entrevista" section missing entirely, so existing
  // per-module quizWeek/reflexWeek/interviewWeek assignments couldn't be seen OR edited.
  // Root cause: `suggestedModules` (Step4Data.modules) was sent to wizard/save and used
  // to create modules + decide quiz/reflection/interview at THAT moment, but never
  // itself persisted anywhere — preloadCourse had nothing to restore it from. Mirrors
  // planWeeklyPlan above (same save/restore shape).
  planModules        Json?
  // Set when a wizard-lessons-bulk generation job is dispatched, cleared when it reaches
  // done/done_incomplete/error — lets the admin course editor show "still generating"
  // even after the evaluator navigates away from the Lux Planner wizard screen (Trello
  // DmPpbrff, 2026-08-31: "no hay ninguna referencia visual... por qué porcentaje vamos").
  activeGenerationJobId String?
  // Trello *LUX SCHEDULER* (Mack, 2026-09-15, 15:36): "yo quisiera que se
  // respete que ese Ensamble Instrumental se dé siempre en el aula de
  // ensayos... eso bloquearía el uso de ese aula para un horario en
  // específico directamente para ese curso." Elegido desde la sección 3 del
  // wizard — persiste entre generaciones, no es un override de una sola vez.
  preferredRoomId   String?
  sessions           CourseSession[]
  evaluationEvents   EvaluationEvent[]
  modules            Module[]
  scheduledClasses   ScheduledClass[]
}

// Lux Scheduler (Trello *LUX SCHEDULER*, 2026-09-10). Disponibilidad semanal
// auto-gestionada por el profesor — uno-a-muchos: varios bloques por día son
// válidos (ej. mañana y tarde separados). evaluatorId = Cognito username, no
// hay modelo User en este schema (ver admin/profile.ts, todo vive en Cognito).
model TeacherAvailability {
  id          String   @id @default(cuid())
  evaluatorId String
  dayOfWeek   Int      // 0=Domingo .. 6=Sábado
  startTime   String   // "08:00" (HH:mm, 24h)
  endTime     String   // "12:00"
  createdAt   DateTime @default(now())

  @@index([evaluatorId])
}

// Tope de carga semanal del profesor — tabla aparte de TeacherAvailability
// porque es 1-a-1 (un tope) vs 1-a-muchos (varios bloques).
model TeacherWorkload {
  evaluatorId       String   @id
  maxCoursesPerWeek Int      @default(5)
  updatedAt         DateTime @updatedAt
}

// Resultado PUBLICADO — la propuesta de horario que el admin aprobó. Las 2-3
// propuestas candidatas NO se persisten acá — viven efímeras en el resultado
// del async job (mismo patrón preview/confirm que ai-regen.ts) hasta aprobar una.
model ScheduledClass {
  id             String   @id @default(cuid())
  academicPeriod String
  courseId       String
  evaluatorId    String
  dayOfWeek      Int
  startTime      String
  endTime        String
  modality       String   // PRESENCIAL_SABADO | VIRTUAL
  classType      String   // INDIVIDUAL | GRUPAL
  studentGroupId String?
  studentIds     String[] @default([])
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Trello *LUX SCHEDULER* (Mack, 2026-09-15): "vamos a agregar la opción de
  // aulas" — solo aplica a sesiones PRESENCIAL (sábado); null para virtuales.
  roomId         String?
  room           ClassRoom? @relation(fields: [roomId], references: [id])

  @@index([courseId])
  @@index([evaluatorId])
  @@index([academicPeriod])
  @@index([roomId])
}

// Trello *LUX SCHEDULER* (Mack, 2026-09-15, 15:36): "la persona (la
// institución) puede agregar aulas, puede agregar edificios... las aulas
// tienen que estar divididas por piso... el edificio puede ser de la A a la
// Z." Edificios agrupan aulas — opcional (una aula puede no tener edificio).
model Building {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  rooms     ClassRoom[]
}

// Trello *LUX SCHEDULER* (Mack, 2026-09-15): "vamos a agregar la opción de
// 'aulas'. Vamos a enumerarlas de la 1 a la 10: 3 aulas para 10 estudiantes,
// 1 aula grande para 15 o 20, 3 aulas medianas para 5, 3 aulas individuales
// (para clases de profesor y estudiante individuales)." Seed inicial en
// scripts/seed-classrooms.
// Ampliado 2026-09-15 (15:36): "si el nombre es 'Aula 101', pero se le
// conoce internamente como 'Salón de ensayos', que esa información se pueda
// agregar" (preferredName); "descripción... si se pueden dar cursos
// teóricos o teórico-prácticos, o cursos de taller" (courseTypeTags, mismos
// valores que Course.courseType — ver COURSE_TYPE_VALUES en courses.ts).
model ClassRoom {
  id             String           @id @default(cuid())
  name           String
  capacity       Int
  buildingId     String?
  building       Building?        @relation(fields: [buildingId], references: [id])
  floor          Int?
  preferredName  String?
  courseTypeTags String[]         @default([])
  createdAt      DateTime         @default(now())
  classes        ScheduledClass[]

  @@index([buildingId])
}

// Trello *LUX SCHEDULER* (Mack, 2026-09-15): "probar los horarios no significa
// que deban publicarse; deben aprobarse... cuando yo vuelva a Lux Scheduler,
// yo tengo que tener la opción de volver a previsualizar... las opciones que
// tengo que tener son: enviar notificación a estudiantes / a evaluadores...
// el botón de publicar debe existir una vez se confirme esa versión, después
// de enviar las notificaciones." Separates the old one-shot "approve" (which
// used to write ScheduledClass rows AND email everyone at once) into three
// steps: approve (this row, no side effects) -> notify (per audience,
// on-demand) -> publish (writes the real ScheduledClass rows, see
// admin/scheduler.ts). One row per academicPeriod — re-approving replaces it.
model ScheduleApproval {
  academicPeriod     String    @id
  proposalJson       Json      // { proposal: ScheduleProposal, courseTitles, teacherNames } — enough to re-render StepReview without regenerating
  status             String    @default("APPROVED") // APPROVED | PUBLISHED
  notifiedStudents   Boolean   @default(false)
  notifiedEvaluators Boolean   @default(false)
  approvedAt         DateTime  @default(now())
  publishedAt        DateTime?
}

model CourseSession {
  id          String   @id @default(cuid())
  courseId    String
  sessionDate DateTime
  weekIndex   Int?
  order       Int
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model AcademicPeriod {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EvaluationEvent {
  id               String    @id @default(cuid())
  courseId         String
  type             String
  name             String
  dueDate          DateTime?
  weight           Float
  instructions     String?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  moduleId         String?
  vapiObjectives   String?
  vapiPrompt       String?
  targetStudentIds String[]  @default([])
  isArchived       Boolean   @default(false)
  isDraft          Boolean   @default(false)
  lessonScript     String?
  lessonVideoUrl   String?
  // Lux Mentor Class restructure (Trello DmPpbrff, 2026-08-31 04:01): the exposition is
  // now narrated by Amazon Polly (male voice) BEFORE Vapi ever connects — Vapi is used
  // only for the live Q&A. lessonAudioUrl = narrated lessonScript + the "ask your
  // questions now" transition line, one continuous clip. closingScript/closingAudioUrl =
  // the ~40s Bedrock-written, Polly-narrated module recap played after the call ends.
  lessonAudioUrl   String?
  closingScript    String?
  closingAudioUrl  String?
  // Lux Mentor Class exposition redesign (Trello DmPpbrff, 2026-09-01 01:10 — Mack:
  // wants a dedicated pre-call screen with the lessonScript as readable HTML, live
  // captions synced to the narration, and a notes area). Polly's sentence-level
  // timing marks for lessonAudioUrl, same shape as Lesson.speechMarks for carousels.
  lessonSpeechMarks Json?
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
}

model Module {
  id           String     @id @default(cuid())
  courseId     String
  order        Int
  title        String
  description  String
  duration     String
  passingScore Int
  lessons      Lesson[]
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@unique([courseId, order])
}

model Lesson {
  id             String   @id @default(cuid())
  moduleId       String
  order          Int
  title          String
  duration       String
  youtubeId      String   @default("")
  imageUrl       String?
  points         String[]
  tip            String
  content        String?
  type           String   @default("video")
  audioUrl       String?
  prevSnapshot   String?
  // Lux Carrousel (type="carousel") — array of {imageUrl, onScreenText, startMs, endMs},
  // audio narration reuses audioUrl above. speechMarks is Polly's raw per-sentence timing
  // JSON, kept separately so the player can re-derive slide boundaries if needed.
  carouselSlides Json?
  speechMarks    Json?
  pdfRecapUrl    String?
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  challenges     LessonChallenge[]

  @@unique([moduleId, order])
}

// Trello DmPpbrff (Mack, 2026-09-18): "retos de atención" — micro-interacciones
// de gamificación embebidas en las lecciones. Máx 2-3 por módulo, distribuidas
// aleatoriamente entre sus lecciones. Tipos: SOCRÁTICA (mito V/F) y ORÁCULO
// (escenario + 2 opciones). No bloquean el avance — el error solo retroalimenta.
model LessonChallenge {
  id             String   @id @default(cuid())
  moduleId       String
  lessonId       String
  paragraphIndex Int      // insert after this paragraph block (0-based)
  type           String   // SOCRÁTICA | ORÁCULO
  question       String
  options        String[] @default([])
  correctIndex   Int
  explanation    String
  xpReward       Int      @default(5)
  createdAt      DateTime @default(now())
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Question {
  id           String   @id @default(cuid())
  moduleId     String
  order        Int
  text         String
  options      String[]
  correctIndex Int
  // On-demand Polly neural narration cache, same pattern as Lesson.audioUrl (Trello
  // DmPpbrff, 2026-09-03 — Mack: quiz/exam questions still fell back to the browser's
  // free voice; TextToSpeechButton only upgrades to Polly when given something to
  // cache the generated audio on).
  audioUrl     String?
  audioUrlMale String?
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
}

model StudentGroup {
  id                   String                  @id @default(cuid())
  name                 String
  description          String?
  createdAt            DateTime                @default(now())
  color                String                  @default("#17527E")
  createdByEvaluatorId String?
  // Trello DmPpbrff, 2026-09-07 (Mack): "se puedan crear grupos base donde
  // estén asignados a semestres específicos, que estos estén interconectados
  // a cuando Lux Planner crea cursos" — same free-text period name as
  // Course.academicPeriod / the AcademicPeriod reusable-dropdown model, not a
  // separate "semester" concept, so a group and the courses created for it
  // share one vocabulary (e.g. "2026-1"). Nullable: existing groups have none.
  academicPeriod       String?
  evaluators           StudentGroupEvaluator[]
  members              StudentGroupMember[]
}

model StudentGroupMember {
  groupId           String
  userId            String
  addedAt           DateTime     @default(now())
  enrolledCourseIds String[]     @default([])
  group             StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model StudentGroupEvaluator {
  groupId     String
  evaluatorId String
  assignedAt  DateTime     @default(now())
  group       StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, evaluatorId])
}
